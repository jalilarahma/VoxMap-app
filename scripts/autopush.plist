<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.voxmap.autopush</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "/Users/jalila/Documents/Claude/Projects/VoxMap/voxmap-app" &amp;&amp; /usr/bin/git fetch -q origin main 2&gt;/dev/null &amp;&amp; if [ "$(/usr/bin/git rev-list --count origin/main..HEAD 2&gt;/dev/null)" -gt 0 ]; then /usr/bin/git push origin main; fi</string>
  </array>

  <!-- Run every 60 seconds while logged in. -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Logs (helpful if you ever want to debug) -->
  <key>StandardOutPath</key>
  <string>/Users/jalila/Library/Logs/voxmap-autopush.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jalila/Library/Logs/voxmap-autopush.log</string>

  <!-- Standard PATH so /usr/bin/git etc. resolve -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
